# OpeRouter settings. The model MUST support tool calling
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6
OPENROUTER_APP_URL=https://github.com/h-alice/datacenter-agent
OPENROUTER_APP_TITLE=datacenter-agent
OPENROUTER_MAX_TOKENS=4096
OPENROUTER_TEMPERATURE=0.2

# Datacenter MCP endpoint.
DATACENTER_MCP_URL=http://127.0.0.1:8000/mcp

# Falcon identity / local permissions stub.
# Keep this value local and make it at least 32 bytes. Never commit a real pepper.
ACTOR_KEY_PEPPER=replace-with-at-least-32-byte-local-pepper
# REQUIRED for the Falcon permissions client. There is no checked-in default host, so
# boot fails if this is unset and [identity].base_url is also absent (prevents prod tokens
# from being sent to an unintended Falcon). Local dev points it at the stub.
FALCON_API_BASE_URL=http://127.0.0.1:8787
# OPTIONAL: comma-separated allowlist of Falcon hosts a request may select via
# `X-Falcon-Api-Base-Url` (the BFF sends its own API_BASE_URL). Replaces
# [identity].allowed_base_urls in config/config.toml (dev / stage / prod) when set; the default
# host above is always allowed. Leave unset locally unless you need to route to a real Falcon.
# FALCON_API_ALLOWED_BASE_URLS=https://dev.hdre-eomc.com,https://stage.hdre-eomc.com,https://hdre-eomc.com

# Runtime route wiring. The Rust runtime is the default streaming authority;
# leave this unset (or any non-falsey value) to use it. Set to `false` (or `0`)
# only to roll a request back to the legacy direct path.
RUNTIME_ENABLED=true

HOST=0.0.0.0
PORT=8080

# Bearer token required on every request: `Authorization: Bearer <GLOBAL_TOKEN>`.
# Request missing or wrong token leads to 418 (teapot). Server refuses to start if unset.
GLOBAL_TOKEN=change-me-before-prod
